# Port number the Express server listens on (defaults to 3000 if unset)
PORT=
# Runtime environment mode: development or production
NODE_ENV=
# Public base URL used for links inside verification emails
APP_URL=

# Email address authorized to sign in to the management portal
MANAGEMENT_EMAIL=
# Optional comma-separated Google emails allowed to access management features via Google Sign-In
MANAGEMENT_GOOGLE_EMAILS=
# Password for the management portal account
MANAGEMENT_PASSWORD=
# Random secret used to sign 8-hour management and 7-day client session tokens
MANAGEMENT_TOKEN_SECRET=

# Firebase Admin service account JSON string for Firestore persistence and token checks
FIREBASE_SERVICE_ACCOUNT_JSON=
# Filesystem path to a Firebase or GCP service account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=
# Set to true when running with GCP Application Default Credentials
FIREBASE_USE_ADC=
# Firestore database ID override (defaults to value in firebase-applet-config.json)
FIRESTORE_DATABASE_ID=

# Sender name and email address for outbound auth emails
EMAIL_FROM=
# Resend API key for sending verification and password reset emails
RESEND_API_KEY=
# SMTP server hostname when sending email without Resend
SMTP_HOST=
# SMTP server port number such as 587 or 465
SMTP_PORT=
# SMTP login username
SMTP_USER=
# SMTP login password
SMTP_PASS=

# Google Apps Script Web App URL for forwarding enquiry form submissions
VITE_ENQUIRY_WEBHOOK_URL=
# Shared key sent alongside enquiry webhook payloads to deter casual spam
VITE_ENQUIRY_KEY=
