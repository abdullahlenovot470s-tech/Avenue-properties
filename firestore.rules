rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['id', 'email', 'name']) &&
        data.keys().hasOnly(['id', 'email', 'name', 'photoURL', 'phone', 'emailVerified', 'createdAt', 'savedPropertyIds']) &&
        isValidId(data.id) &&
        data.id == request.auth.uid &&
        data.email is string && data.email.size() > 0 && data.email.size() <= 254 &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000)) &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 32)) &&
        (!('emailVerified' in data) || data.emailVerified is bool) &&
        (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
        (!('savedPropertyIds' in data) || (data.savedPropertyIds is list && data.savedPropertyIds.size() <= 100 && (data.savedPropertyIds.size() == 0 || data.savedPropertyIds[0] is string)));
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow create: if isValidId(userId) && isVerifiedUser() && isOwner(userId) && isValidUser(incoming());
      allow update: if isValidId(userId) && isVerifiedUser() && isOwner(userId) && isValidUser(incoming()) &&
        incoming().id == existing().id &&
        incoming().email == existing().email &&
        (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'photoURL', 'phone', 'emailVerified', 'savedPropertyIds']);
      allow delete: if isValidId(userId) && isOwner(userId);
    }

    // Server-only collections managed exclusively by Express via Firebase Admin SDK
    match /auth_users/{emailHash} {
      allow read, write: if false;
    }
    match /inquiries/{inquiryId} {
      allow read, write: if false;
    }
    match /catalog_projects/{projectId} {
      allow read, write: if false;
    }
    match /catalog_listings/{listingId} {
      allow read, write: if false;
    }
    match /catalog_buy/{buyId} {
      allow read, write: if false;
    }
    match /catalog_rent/{rentId} {
      allow read, write: if false;
    }
    match /catalog_meta/{metaId} {
      allow read, write: if false;
    }
  }
}
